{
  "packageId": "ke.co.vendlex.app",
  "host": "vendlex.vercel.app",
  "name": "VendLex - Kenyan Marketplace & Business Hub",
  "launcherName": "VendLex",
  "themeColor": "#087443",
  "navigationColor": "#071A13",
  "backgroundColor": "#071A13",
  "startUrl": "/?source=playstore",
  "iconUrl": "https://vendlex.vercel.app/logo/vendlex-icon.png",
