      "name": "Marketplace",
      "short_name": "Shop",
      "url": "/marketplace",
      "chosen_icon_url": "https://vendlex.vercel.app/logo/vendlex-icon.png"
    },
    {
      "name": "Local Services",
      "short_name": "Services",
      "url": "/services",
      "chosen_icon_url": "https://vendlex.vercel.app/logo/vendlex-icon.png"
    },
    {
      "name": "Seller Portal",
      "short_name": "Sell",
      "url": "/seller/dashboard",
      "chosen_icon_url": "https://vendlex.vercel.app/logo/vendlex-icon.png"
    },
    {
      "name": "Advertise Business",
      "short_name": "Advertise",
      "url": "/advertise",
      "chosen_icon_url": "https://vendlex.vercel.app/logo/vendlex-icon.png"
    }
  ],
  "fallbackType": "customtabs",
  "features": {
    "locationDelegation": {
      "enabled": true
    },
    "playBilling": {
      "enabled": false
    }
