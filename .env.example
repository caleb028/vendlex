# ==============================================================================
# VENDLEX KENYA — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env.local for local development or set in Vercel / Render dashboard
# NEVER commit real credentials to source control.
# ==============================================================================

# ==============================================================================
# 1. CORE APPLICATION & DEPLOYMENT URLS
# ==============================================================================
# Base URL of the Next.js Frontend (Vercel)
NEXT_PUBLIC_APP_URL="https://vendlex.co.ke"

# Base URL of the Node.js Express API Backend (Render)
# Set to "https://api.vendlex.co.ke" or "https://vendlex-api.onrender.com" in production
NEXT_PUBLIC_API_URL="https://api.vendlex.co.ke"

# Environment ("development", "test", or "production")
NODE_ENV="production"

# Port for the Node.js API server (Render automatically sets process.env.PORT)
PORT=5000

# Allowed CORS Origins for Backend API (comma-separated if multiple)
CORS_ORIGIN="https://vendlex.co.ke,https://www.vendlex.co.ke"

# ==============================================================================
# 2. PERSISTENT POSTGRESQL DATABASE
# ==============================================================================
# PostgreSQL Connection URL (Provided by Render PostgreSQL, Supabase, Neon, or AWS RDS)
DATABASE_URL="postgresql://username:password@hostname:5432/vendlex_db?sslmode=require"

# Direct connection URL (optional, for migrations with connection poolers)
DIRECT_URL="postgresql://username:password@hostname:5432/vendlex_db"

# Local Data Directory Fallback (used when DATABASE_URL is not provided)
DATA_DIR="./data"

# ==============================================================================
# 3. AUTHENTICATION & SECURITY SECRETS
# ==============================================================================
# Crypto secrets for sessions and tokens (generate via: openssl rand -hex 32)
JWT_SECRET="your_secure_random_jwt_secret_hex_string"
SESSION_SECRET="your_secure_random_session_secret_hex_string"
ADMIN_API_SECRET="your_secure_platform_super_admin_passcode"

# ==============================================================================
# 4. SAFARICOM DARAJA LIP NA M-PESA
# ==============================================================================
MPESA_ENVIRONMENT="sandbox" # "sandbox" or "production"
MPESA_SHORTCODE="174379"
MPESA_CONSUMER_KEY="your_daraja_consumer_key"
MPESA_CONSUMER_SECRET="your_daraja_consumer_secret"
MPESA_PASSKEY="your_daraja_passkey"
MPESA_CALLBACK_URL="https://api.vendlex.co.ke/api/daraja/callback"
MPESA_CALLBACK_SECRET="your_daraja_webhook_hmac_secret"

# ==============================================================================
# 5. GOOGLE ADVERTISING & ANALYTICS
# ==============================================================================
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"
GA4_API_SECRET="your_ga4_measurement_protocol_api_secret"
GOOGLE_ADS_CUSTOMER_ID="123-456-7890"

# ==============================================================================
# 6. META (FACEBOOK & INSTAGRAM) ADVERTISING & CAPI
# ==============================================================================
NEXT_PUBLIC_META_PIXEL_ID="123456789012345"
META_ACCESS_TOKEN="EAAB..."
META_PIXEL_ID="123456789012345"
META_TEST_EVENT_CODE=""

# ==============================================================================
# 7. TRANSACTIONAL EMAIL SYSTEM (SMTP)
# ==============================================================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your_email_account@gmail.com"
SMTP_PASS="your_smtp_app_password"
EMAIL_FROM="VendLex Security <no-reply@vendlex.co.ke>"
